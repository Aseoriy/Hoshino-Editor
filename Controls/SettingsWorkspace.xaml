<UserControl x:Class="HoshinoEditor.Controls.SettingsWorkspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:HoshinoEditor.Models">
  <UserControl.Resources>
    <Style x:Key="CardTitle" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Text}" /><Setter Property="FontSize" Value="14" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style x:Key="CardHint" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextDim}" /><Setter Property="FontSize" Value="11" /><Setter Property="Margin" Value="0,4,0,0" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
  </UserControl.Resources>
  <Grid Background="{DynamicResource Bg}">
    <Grid.RowDefinitions><RowDefinition Height="82" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Border BorderBrush="{DynamicResource Line1}" BorderThickness="0,0,0,1">
      <Grid Margin="34,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="⚙" Foreground="{DynamicResource AccentBright}" FontSize="24" Margin="0,0,12,0" /><TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" /></StackPanel><Button Style="{DynamicResource PrimaryButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="22,10" Click="Done_Click" AutomationProperties.Name="Close settings">✓  Done</Button></Grid>
    </Border>
    <Grid Grid.Row="1" Margin="34,26"><Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <StackPanel>
        <RadioButton Style="{DynamicResource SettingsNavButton}" GroupName="Settings" IsChecked="True" Content="◉   Appearance" Tag="Appearance" Checked="Nav_Checked" />
        <RadioButton Style="{DynamicResource SettingsNavButton}" GroupName="Settings" Content="✎   Editor" Tag="Editor" Checked="Nav_Checked" />
        <RadioButton Style="{DynamicResource SettingsNavButton}" GroupName="Settings" Content="⚡   Performance" Tag="Performance" Checked="Nav_Checked" />
        <RadioButton Style="{DynamicResource SettingsNavButton}" GroupName="Settings" Content="▱   Files &amp; export" Tag="Files" Checked="Nav_Checked" />
        <RadioButton Style="{DynamicResource SettingsNavButton}" GroupName="Settings" Content="⌨   Shortcuts" Tag="Shortcuts" Checked="Nav_Checked" />
        <RadioButton Style="{DynamicResource SettingsNavButton}" GroupName="Settings" Content="ⓘ   About" Tag="About" Checked="Nav_Checked" />
      </StackPanel>
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><Grid MaxWidth="980" HorizontalAlignment="Stretch">
        <StackPanel x:Name="AppearancePanel">
          <TextBlock Text="APPEARANCE" Style="{DynamicResource SectionLabel}" Margin="4,0,0,10" />
          <Border Style="{DynamicResource SettingsCard}"><StackPanel><TextBlock Text="Theme" Style="{StaticResource CardTitle}" /><TextBlock Text="Choose a built-in palette or enter your own accent color." Style="{StaticResource CardHint}" /><StackPanel Orientation="Horizontal" Margin="0,14,0,0"><ComboBox x:Name="ThemeCombo" Width="180" Height="32" SelectionChanged="Theme_Changed" AutomationProperties.Name="Theme" /><TextBox x:Name="CustomAccentBox" Style="{DynamicResource Field}" Width="120" Margin="10,0,0,0" AutomationProperties.Name="Custom accent color" /><Button Style="{DynamicResource SecondaryButton}" Height="32" Margin="8,0,0,0" Click="ApplyAccent_Click">Apply accent</Button></StackPanel><TextBlock x:Name="AccentStatus" Foreground="{DynamicResource TextDim}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" /></StackPanel></Border>
          <Border Style="{DynamicResource SettingsCard}"><CheckBox Style="{DynamicResource SettingsToggle}" IsChecked="{Binding ShowTooltips}"><StackPanel><TextBlock Text="Show tooltips" Style="{StaticResource CardTitle}" /><TextBlock Text="Show labels and shortcuts when hovering over controls." Style="{StaticResource CardHint}" /></StackPanel></CheckBox></Border>
          <Border Style="{DynamicResource SettingsCard}"><CheckBox Style="{DynamicResource SettingsToggle}" IsChecked="{Binding ShowStatusBar}"><StackPanel><TextBlock Text="Show status bar" Style="{StaticResource CardTitle}" /><TextBlock Text="Display dimensions, progress, and local-processing status." Style="{StaticResource CardHint}" /></StackPanel></CheckBox></Border>
        </StackPanel>

        <StackPanel x:Name="EditorPanel" Visibility="Collapsed">
          <TextBlock Text="EDITOR" Style="{DynamicResource SectionLabel}" Margin="4,0,0,10" />
          <Border Style="{DynamicResource SettingsCard}"><CheckBox Style="{DynamicResource SettingsToggle}" IsChecked="{Binding CheckerboardCanvas}"><StackPanel><TextBlock Text="Transparency checkerboard" Style="{StaticResource CardTitle}" /><TextBlock Text="Show transparent regions with a checkerboard backdrop." Style="{StaticResource CardHint}" /></StackPanel></CheckBox></Border>
          <Border Style="{DynamicResource SettingsCard}"><CheckBox Style="{DynamicResource SettingsToggle}" IsChecked="{Binding ShowCanvasGrid}"><StackPanel><TextBlock Text="Canvas grid" Style="{StaticResource CardTitle}" /><TextBlock Text="Overlay a subtle alignment grid on the composition canvas." Style="{StaticResource CardHint}" /></StackPanel></CheckBox></Border>
          <Border Style="{DynamicResource SettingsCard}"><CheckBox Style="{DynamicResource SettingsToggle}" IsChecked="{Binding SnapLayersToGrid}"><StackPanel><TextBlock Text="Snap layers to grid" Style="{StaticResource CardTitle}" /><TextBlock Text="Snap moved image layers to ten-pixel increments." Style="{StaticResource CardHint}" /></StackPanel></CheckBox></Border>
          <Border Style="{DynamicResource SettingsCard}"><CheckBox Style="{DynamicResource SettingsToggle}" IsChecked="{Binding CenterNewLayers}"><StackPanel><TextBlock Text="Center imported layers" Style="{StaticResource CardTitle}" /><TextBlock Text="Place new images near the center of the current composition." Style="{StaticResource CardHint}" /></StackPanel></CheckBox></Border>
          <Border Style="{DynamicResource SettingsCard}"><CheckBox Style="{DynamicResource SettingsToggle}" IsChecked="{Binding ConfirmBeforeReset}"><StackPanel><TextBlock Text="Confirm destructive resets" Style="{StaticResource CardTitle}" /><TextBlock Text="Ask before clearing edits or removing every layer." Style="{StaticResource CardHint}" /></StackPanel></CheckBox></Border>
          <Border Style="{DynamicResource SettingsCard}"><StackPanel><TextBlock Text="Undo history" Style="{StaticResource CardTitle}" /><TextBlock Text="Maximum edit states kept in memory." Style="{StaticResource CardHint}" /><Slider x:Name="UndoLimitSlider" Minimum="10" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding UndoLimit}" Margin="0,12,0,0" AutomationProperties.Name="Undo history limit" /><TextBlock Text="{Binding ElementName=UndoLimitSlider, Path=Value, StringFormat={}{0:0} states}" Foreground="{DynamicResource TextDim}" /></StackPanel></Border>
        </StackPanel>

        <StackPanel x:Name="PerformancePanel" Visibility="Collapsed">
          <TextBlock Text="PERFORMANCE" Style="{DynamicResource SectionLabel}" Margin="4,0,0,10" />
          <Border Style="{DynamicResource SettingsCard}"><CheckBox Style="{DynamicResource SettingsToggle}" IsChecked="{Binding PreferGpuAcceleration}"><StackPanel><TextBlock Text="GPU-first processing" Style="{StaticResource CardTitle}" /><TextBlock Text="Prefer hardware rendering and FFmpeg GPU encoders when available; safely fall back to CPU." Style="{StaticResource CardHint}" /></StackPanel></CheckBox></Border>
          <Border Style="{DynamicResource SettingsCard}"><CheckBox Style="{DynamicResource SettingsToggle}" IsChecked="{Binding HighQualityPreview}"><StackPanel><TextBlock Text="High-quality previews" Style="{StaticResource CardTitle}" /><TextBlock Text="Use high-quality interpolation while zooming and transforming images." Style="{StaticResource CardHint}" /></StackPanel></CheckBox></Border>
          <Border Style="{DynamicResource SettingsCard}"><CheckBox Style="{DynamicResource SettingsToggle}" IsChecked="{Binding AutoSaveVideoProjects}"><StackPanel><TextBlock Text="Autosave video projects" Style="{StaticResource CardTitle}" /><TextBlock Text="Periodically preserve recoverable project state." Style="{StaticResource CardHint}" /></StackPanel></CheckBox></Border>
          <Border Style="{DynamicResource SettingsCard}"><CheckBox Style="{DynamicResource SettingsToggle}" IsChecked="{Binding RestoreLastSession}"><StackPanel><TextBlock Text="Restore autosaved session" Style="{StaticResource CardTitle}" /><TextBlock Text="Reopen an unsaved video recovery project after an interrupted session." Style="{StaticResource CardHint}" /></StackPanel></CheckBox></Border>
          <Border Style="{DynamicResource SettingsCard}"><StackPanel><TextBlock Text="Autosave interval" Style="{StaticResource CardTitle}" /><Slider x:Name="AutoSaveSlider" Minimum="1" Maximum="30" TickFrequency="1" Value="{Binding AutoSaveMinutes}" Margin="0,12,0,0" AutomationProperties.Name="Autosave interval in minutes" /><TextBlock Text="{Binding ElementName=AutoSaveSlider, Path=Value, StringFormat={}{0:0} minutes}" Foreground="{DynamicResource TextDim}" /></StackPanel></Border>
        </StackPanel>

        <StackPanel x:Name="FilesPanel" Visibility="Collapsed">
          <TextBlock Text="FILES &amp; EXPORT" Style="{DynamicResource SectionLabel}" Margin="4,0,0,10" />
          <Border Style="{DynamicResource SettingsCard}"><StackPanel><TextBlock Text="Default image format" Style="{StaticResource CardTitle}" /><ComboBox x:Name="FormatCombo" Width="180" Height="32" HorizontalAlignment="Left" Margin="0,12,0,0" SelectedValuePath="Content" SelectedValue="{Binding DefaultExportFormat}"><ComboBoxItem Content="PNG" /><ComboBoxItem Content="JPEG" /><ComboBoxItem Content="TIFF" /><ComboBoxItem Content="BMP" /></ComboBox></StackPanel></Border>
          <Border Style="{DynamicResource SettingsCard}"><StackPanel><TextBlock Text="JPEG quality" Style="{StaticResource CardTitle}" /><Slider x:Name="JpegSlider" Minimum="50" Maximum="100" Value="{Binding JpegQuality}" Margin="0,12,0,0" AutomationProperties.Name="JPEG export quality" /><TextBlock Text="{Binding ElementName=JpegSlider, Path=Value, StringFormat={}{0:0}%}" Foreground="{DynamicResource TextDim}" /></StackPanel></Border>
          <Border Style="{DynamicResource SettingsCard}"><CheckBox Style="{DynamicResource SettingsToggle}" IsChecked="{Binding RememberExportFolder}"><StackPanel><TextBlock Text="Remember export folder" Style="{StaticResource CardTitle}" /><TextBlock Text="Open future export dialogs in the last folder used." Style="{StaticResource CardHint}" /></StackPanel></CheckBox></Border>
          <Border Style="{DynamicResource SettingsCard}"><CheckBox Style="{DynamicResource SettingsToggle}" IsChecked="{Binding StartWithWindows}"><StackPanel><TextBlock Text="Start with Windows" Style="{StaticResource CardTitle}" /><TextBlock Text="Launch Hoshino Editor when you sign in." Style="{StaticResource CardHint}" /></StackPanel></CheckBox></Border>
          <Border Style="{DynamicResource SettingsCard}"><StackPanel><TextBlock Text="Close button behavior" Style="{StaticResource CardTitle}" /><TextBlock Text="Choose whether × exits Hoshino or minimizes it." Style="{StaticResource CardHint}" /><ComboBox Width="180" Height="32" HorizontalAlignment="Left" Margin="0,12,0,0" SelectedValuePath="Content" SelectedValue="{Binding CloseButtonAction}"><ComboBoxItem Content="Exit" /><ComboBoxItem Content="Minimize" /></ComboBox></StackPanel></Border>
        </StackPanel>

        <StackPanel x:Name="ShortcutsPanel" Visibility="Collapsed">
          <TextBlock Text="KEYBOARD CONTROLS" Style="{DynamicResource SectionLabel}" Margin="4,0,0,10" />
          <TextBlock Text="Click a shortcut field, then press the new key combination. Backspace clears it; Escape remains reserved for canceling tools and closing settings." Style="{StaticResource CardHint}" Margin="4,0,0,10" />
          <ItemsControl x:Name="ShortcutList">
            <ItemsControl.ItemTemplate><DataTemplate>
              <Border Style="{DynamicResource SettingsCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="190" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="{Binding Name}" Style="{StaticResource CardTitle}" /><TextBlock Text="{Binding Description}" Style="{StaticResource CardHint}" /></StackPanel>
                <TextBox Grid.Column="1" Style="{DynamicResource Field}" Text="{Binding Display}" Tag="{Binding Id}" IsReadOnly="True" Cursor="Arrow" Padding="10,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontFamily="{DynamicResource MonoFont}" Height="34" PreviewKeyDown="ShortcutBox_PreviewKeyDown" GotKeyboardFocus="ShortcutBox_GotKeyboardFocus" AutomationProperties.Name="{Binding Name, StringFormat=Shortcut for {0}}" />
              </Grid></Border>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <Grid Margin="4,4,4,0"><TextBlock x:Name="ShortcutStatus" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" /><Button Style="{DynamicResource SecondaryButton}" Height="34" Padding="14,0" HorizontalAlignment="Right" Click="ResetShortcuts_Click">Reset defaults</Button></Grid>
          <!-- Legacy static shortcut reference replaced by editable bindings.
          <Border Style="{DynamicResource SettingsCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Open / import images" Style="{StaticResource CardTitle}" /><TextBlock Text="Import multiple files in the photo workspace." Style="{StaticResource CardHint}" /></StackPanel><TextBlock Grid.Column="1" Text="Ctrl+O / Ctrl+I" FontFamily="{DynamicResource MonoFont}" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid></Border>
          <Border Style="{DynamicResource SettingsCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions><TextBlock Text="Export / merge" Style="{StaticResource CardTitle}" /><TextBlock Grid.Column="1" Text="Ctrl+S / Ctrl+Shift+S" FontFamily="{DynamicResource MonoFont}" HorizontalAlignment="Right" /></Grid></Border>
          <Border Style="{DynamicResource SettingsCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions><TextBlock Text="Undo / redo" Style="{StaticResource CardTitle}" /><TextBlock Grid.Column="1" Text="Ctrl+Z / Ctrl+Y" FontFamily="{DynamicResource MonoFont}" HorizontalAlignment="Right" /></Grid></Border>
          <Border Style="{DynamicResource SettingsCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions><TextBlock Text="Zoom in / out / reset" Style="{StaticResource CardTitle}" /><TextBlock Grid.Column="1" Text="Ctrl++ / Ctrl+- / Ctrl+0" FontFamily="{DynamicResource MonoFont}" HorizontalAlignment="Right" /></Grid></Border>
          <Border Style="{DynamicResource SettingsCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions><TextBlock Text="Fit composition" Style="{StaticResource CardTitle}" /><TextBlock Grid.Column="1" Text="Ctrl+9" FontFamily="{DynamicResource MonoFont}" HorizontalAlignment="Right" /></Grid></Border>
          <Border Style="{DynamicResource SettingsCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions><TextBlock Text="Delete selected layer" Style="{StaticResource CardTitle}" /><TextBlock Grid.Column="1" Text="Delete" FontFamily="{DynamicResource MonoFont}" HorizontalAlignment="Right" /></Grid></Border>
          <Border Style="{DynamicResource SettingsCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions><TextBlock Text="Play / pause video" Style="{StaticResource CardTitle}" /><TextBlock Grid.Column="1" Text="Space" FontFamily="{DynamicResource MonoFont}" HorizontalAlignment="Right" /></Grid></Border>
          <Border Style="{DynamicResource SettingsCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions><TextBlock Text="Settings / cancel tool" Style="{StaticResource CardTitle}" /><TextBlock Grid.Column="1" Text="Ctrl+, / Esc" FontFamily="{DynamicResource MonoFont}" HorizontalAlignment="Right" /></Grid></Border>
          -->
        </StackPanel>

        <StackPanel x:Name="AboutPanel" Visibility="Collapsed">
          <TextBlock Text="ABOUT" Style="{DynamicResource SectionLabel}" Margin="4,0,0,10" />
          <Border Style="{DynamicResource SettingsCard}" Padding="24"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="76" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="62" Height="62" CornerRadius="14" ClipToBounds="True"><Image Source="/Assets/HoshinoLogo.jpg" Stretch="UniformToFill" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Hoshino Editor" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="Create in starlight.  ·  A Sail Solutions app" Foreground="{DynamicResource TextDim}" Margin="0,5,0,0" /><TextBlock x:Name="AboutVersionText" Text="v0.9.0-beta-3" Foreground="{DynamicResource AccentBright}" Margin="0,6,0,0" /></StackPanel></Grid></Border>
          <Border Style="{DynamicResource SettingsCard}"><CheckBox Style="{DynamicResource SettingsToggle}" IsChecked="{Binding CheckForUpdates}"><StackPanel><TextBlock Text="Check for updates" Style="{StaticResource CardTitle}" /><TextBlock Text="Check for a newer stable release when Hoshino starts." Style="{StaticResource CardHint}" /></StackPanel></CheckBox></Border>
          <Border Style="{DynamicResource SettingsCard}"><CheckBox Style="{DynamicResource SettingsToggle}" IsChecked="{Binding IncludeBetaUpdates}"><StackPanel><TextBlock Text="Beta updates" Style="{StaticResource CardTitle}" /><TextBlock Text="Include early builds that may be less tested. Beta installations always receive newer beta fixes." Style="{StaticResource CardHint}" /></StackPanel></CheckBox></Border>
          <Border Style="{DynamicResource SettingsCard}"><Grid><StackPanel><TextBlock Text="Software update" Style="{StaticResource CardTitle}" /><TextBlock Text="Check GitHub Releases now for a compatible installer." Style="{StaticResource CardHint}" /></StackPanel><Button Style="{DynamicResource SecondaryButton}" Height="34" Padding="14,0" HorizontalAlignment="Right" VerticalAlignment="Center" Click="CheckUpdates_Click">Check now</Button></Grid></Border>
          <Border Style="{DynamicResource SettingsCard}"><StackPanel><TextBlock Text="Privacy" Style="{StaticResource CardTitle}" /><TextBlock Text="Photo and video editing stays on this PC. Background removal and upscaling are local and do not send media to a cloud service." Style="{StaticResource CardHint}" /></StackPanel></Border>
        </StackPanel>
      </Grid></ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
