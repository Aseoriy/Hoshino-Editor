<UserControl x:Class="HoshinoEditor.Controls.StartWorkspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop">
  <Grid Background="Transparent">
    <Ellipse Width="680" Height="680" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-260,-330,0,0" IsHitTestVisible="False">
      <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#309333EA" Offset="0" /><GradientStop Color="#009333EA" Offset="1" /></RadialGradientBrush></Ellipse.Fill>
    </Ellipse>
    <Grid Margin="54,36">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <StackPanel>
        <TextBlock Text="MAKE SOMETHING SMALL, FAST, BEAUTIFUL" Style="{StaticResource SectionLabel}" Foreground="{DynamicResource AccentBright}" />
        <TextBlock Text="What are we editing?" FontSize="34" FontWeight="SemiBold" Margin="0,8,0,6" />
        <TextBlock Text="Drop in a file or begin with a focused workspace. Everything stays on this PC." Foreground="{DynamicResource TextDim}" FontSize="14" />
      </StackPanel>

      <Grid Grid.Row="1" VerticalAlignment="Center" MaxWidth="940">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Button Grid.Column="0" Click="Photo_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalContentAlignment="Stretch">
          <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="card" Style="{StaticResource PanelCard}" Padding="28" MinHeight="270"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="card" Property="Background" Value="{DynamicResource AccentWash}" /><Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource AccentLine}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
          <Grid>
            <Border Width="58" Height="58" CornerRadius="15" Background="{DynamicResource AccentWash2}" BorderBrush="{DynamicResource AccentLine}" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top"><TextBlock Text="▧" FontSize="29" Foreground="{DynamicResource AccentBright}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            <StackPanel VerticalAlignment="Bottom">
              <TextBlock Text="PHOTO" Style="{StaticResource SectionLabel}" />
              <TextBlock Text="Photo editor" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,7" />
              <TextBlock Text="Crop, rotate, tune light and color, then export a clean image." Foreground="{DynamicResource TextDim}" TextWrapping="Wrap" FontSize="13" />
              <TextBlock Text="PNG  ·  JPG  ·  WEBP  ·  BMP" Foreground="{DynamicResource TextFaint}" FontFamily="{StaticResource MonoFont}" FontSize="10" Margin="0,20,0,0" />
            </StackPanel>
          </Grid>
        </Button>

        <Button Grid.Column="2" Click="Video_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalContentAlignment="Stretch">
          <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="card" Style="{StaticResource PanelCard}" Padding="28" MinHeight="270"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="card" Property="Background" Value="{DynamicResource AccentWash}" /><Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource AccentLine}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
          <Grid>
            <Border Width="58" Height="58" CornerRadius="15" Background="{DynamicResource AccentWash2}" BorderBrush="{DynamicResource AccentLine}" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top"><TextBlock Text="▶" FontSize="23" Foreground="{DynamicResource AccentBright}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            <StackPanel VerticalAlignment="Bottom">
              <TextBlock Text="VIDEO" Style="{StaticResource SectionLabel}" />
              <TextBlock Text="Video editor" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,7" />
              <TextBlock Text="Arrange clips, trim, split, change speed, preview, and render." Foreground="{DynamicResource TextDim}" TextWrapping="Wrap" FontSize="13" />
              <TextBlock Text="MP4  ·  MOV  ·  MKV  ·  WEBM" Foreground="{DynamicResource TextFaint}" FontFamily="{StaticResource MonoFont}" FontSize="10" Margin="0,20,0,0" />
            </StackPanel>
          </Grid>
        </Button>
      </Grid>

      <Grid Grid.Row="2">
        <Button Style="{StaticResource SecondaryButton}" Height="38" HorizontalAlignment="Left" Click="Open_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="＋" FontSize="16" Margin="0,0,8,0" /><TextBlock Text="Open media" VerticalAlignment="Center" /></StackPanel></Button>
        <TextBlock Text="Tip: right-click any supported media file → Open with Hoshino Editor" Foreground="{DynamicResource TextFaint}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
      </Grid>
    </Grid>
  </Grid>
</UserControl>
