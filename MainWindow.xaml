<Window x:Class="HoshinoEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Hoshino Editor" Icon="Assets/Hoshino.ico" Width="1280" Height="800" MinWidth="820" MinHeight="520"
        WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource AppBackground}"
        Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown"
        AutomationProperties.Name="Hoshino Editor">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Border BorderBrush="{DynamicResource Line2}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="46" /><RowDefinition Height="*" /><RowDefinition x:Name="StatusRow" Height="28" /></Grid.RowDefinitions>

      <Grid Grid.Row="0" Background="{DynamicResource BgChrome}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
          <Border Width="27" Height="27" Margin="0,0,10,0" CornerRadius="7" ClipToBounds="True"><Image Source="Assets/HoshinoLogo.jpg" Stretch="UniformToFill" /></Border>
          <TextBlock Text="Hoshino" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
        </StackPanel>
        <Grid Grid.Column="1">
          <Border Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" />
          <TextBlock x:Name="DocumentTitle" Text="  /  New project" Foreground="{DynamicResource TextDim}" FontSize="12"
                     Margin="0,0,12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" />
        </Grid>
        <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Style="{StaticResource CaptionButton}" Content="⚙" Click="Settings_Click" ToolTip="Settings (Ctrl+,)" AutomationProperties.Name="Settings" />
          <Button Style="{StaticResource CaptionButton}" Content="—" Click="Minimize_Click" ToolTip="Minimize" AutomationProperties.Name="Minimize window" />
          <Button Style="{StaticResource CaptionButton}" Content="□" Click="Maximize_Click" ToolTip="Maximize" AutomationProperties.Name="Maximize or restore window" />
          <Button x:Name="CloseButton" Style="{StaticResource CaptionButton}" Content="×" Click="Close_Click" ToolTip="Close" AutomationProperties.Name="Close window" />
        </StackPanel>
      </Grid>

      <ContentControl x:Name="WorkspaceHost" Grid.Row="1" />

      <Border x:Name="StatusBar" Grid.Row="2" Background="{DynamicResource BgChrome}" BorderBrush="{DynamicResource Line1}" BorderThickness="0,1,0,0">
        <Grid Margin="12,0">
          <TextBlock x:Name="StatusText" Text="Ready" FontSize="11" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"
                     AutomationProperties.LiveSetting="Polite" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="{DynamicResource Ok}" Margin="0,0,6,0" />
            <TextBlock Text="LOCAL ONLY" Style="{StaticResource SectionLabel}" />
          </StackPanel>
        </Grid>
      </Border>

      <Border x:Name="Toast" Grid.Row="1" Background="{DynamicResource BgRaised}" BorderBrush="{DynamicResource AccentLine}" BorderThickness="1"
              CornerRadius="10" Padding="14,10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,18"
              Visibility="Collapsed" Panel.ZIndex="20" AutomationProperties.Name="Notification">
        <TextBlock x:Name="ToastText" FontSize="12" MaxWidth="360" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
      </Border>

      <Border x:Name="UpdateOverlay" Grid.RowSpan="3" Background="{DynamicResource ModalBackdrop}" Visibility="Collapsed" Panel.ZIndex="50"
              AutomationProperties.Name="Software update dialog">
        <Border x:Name="UpdateDialog" Width="680" MaxHeight="640" Margin="28" Background="{DynamicResource BgChrome}" BorderBrush="{DynamicResource AccentLine}"
                BorderThickness="1" CornerRadius="16" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center"
                FocusManager.IsFocusScope="True" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel>
              <TextBlock x:Name="UpdateTitle" Text="A Hoshino update is available" FontSize="22" FontWeight="SemiBold" />
              <TextBlock x:Name="UpdateVersionText" Foreground="{DynamicResource AccentBright}" Margin="0,6,0,16" />
            </StackPanel>
            <FlowDocumentScrollViewer x:Name="UpdateNotes" Grid.Row="1" VerticalScrollBarVisibility="Auto" IsToolBarVisible="False"
                                      Background="Transparent" Foreground="{DynamicResource Text}" FontFamily="{DynamicResource AppFont}"
                                      AutomationProperties.Name="Release notes" />
            <StackPanel Grid.Row="2" Margin="0,18,0,0">
              <TextBlock x:Name="UpdateProgressText" Foreground="{DynamicResource TextDim}" FontSize="11" Visibility="Collapsed"
                         AutomationProperties.LiveSetting="Polite" />
              <ProgressBar x:Name="UpdateProgress" Height="7" Minimum="0" Maximum="100" Margin="0,7,0,0" Visibility="Collapsed"
                           Background="{DynamicResource Glass4}" Foreground="{DynamicResource Accent}" BorderThickness="0"
                           AutomationProperties.Name="Update download progress" />
              <Grid Margin="0,15,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Button x:Name="UpdateLaterButton" Grid.Column="1" Style="{StaticResource SecondaryButton}" Height="36" Margin="0,0,8,0" Click="UpdateLater_Click" AutomationProperties.Name="Install update later">Later</Button>
                <Button x:Name="UpdateNowButton" Grid.Column="2" Style="{StaticResource PrimaryButton}" Padding="18,9" Click="UpdateNow_Click" AutomationProperties.Name="Download and install update">Update now</Button>
              </Grid>
            </StackPanel>
          </Grid>
        </Border>
      </Border>
    </Grid>
  </Border>
</Window>
